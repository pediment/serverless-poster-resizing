#!/bin/bash
#
# Deploy Lambda function code to staging
# Uploads code to $LATEST (staging alias points to $LATEST)
#

set -o errexit
set -o nounset
set -o pipefail

FUNCTION_NAME="${FUNCTION_NAME:-resize}"
REGION="${AWS_REGION:-$(aws configure get region)}"

echo "Deploying to staging (\$LATEST)..."
echo "Function: ${FUNCTION_NAME}"
echo "Region: ${REGION}"
echo ""

# Build the Lambda function
echo "Building Lambda function..."
make dist

# Update $LATEST
echo "Uploading new code to \$LATEST..."
aws lambda update-function-code \
  --function-name "${FUNCTION_NAME}" \
  --zip-file fileb://dist/function.zip \
  --region "${REGION}" \
  --output json > /dev/null

echo "Waiting for update to complete..."
aws lambda wait function-updated \
  --function-name "${FUNCTION_NAME}" \
  --region "${REGION}"

echo ""
echo "✓ Code uploaded successfully to \$LATEST"

# Get git info for display
GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

echo ""
echo "Staging is ready to test:"
echo "  Branch: ${GIT_BRANCH}"
echo "  Commit: ${GIT_COMMIT}"
echo "  URL: https://ltgchi86r4.execute-api.us-east-1.amazonaws.com/default/staging/resize"
echo ""
echo "To promote to production: bin/promote"
